# Copy to /opt/lsky/stack.env and chmod 600. Never commit the populated file.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
LSKY_IMAGE=ghcr.io/bigyvc/lsky-pro-docker:latest
TG_IMAGE=lsky-telegram-api:local
TELEGRAM_API_BASE_IMAGE=aiogram/telegram-bot-api:latest
LSKY_CONTAINER_NAME=lsky-pro
LSKY_HTTP_PORT=8089
LSKY_DATA_DIR=/opt/lsky/data
TG_DATA_DIR=/opt/lsky/telegram-api/data
PHP_MEMORY_LIMIT=64M
# Only for the optional compose.stack-build.yaml override:
LSKY_LOCAL_IMAGE=lsky-pro:local
